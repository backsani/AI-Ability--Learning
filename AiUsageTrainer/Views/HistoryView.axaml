<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:AiUsageTrainer.ViewModels"
             xmlns:m="clr-namespace:AiUsageTrainer.Models"
             x:Class="AiUsageTrainer.Views.HistoryView"
             x:DataType="vm:HistoryViewModel">

  <Grid RowDefinitions="Auto,*,Auto">

    <StackPanel Grid.Row="0" Margin="28,28,28,14" Spacing="12">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Spacing="4">
          <TextBlock Classes="h1" Text="지난 연습" />
          <TextBlock Classes="muted" Text="연습을 마칠 때마다 이 목록에 쌓입니다. 항목을 골라 열어보세요." />
        </StackPanel>
        <Button Grid.Column="1" VerticalAlignment="Center" Content="폴더 열기"
                Command="{Binding OpenFolderCommand}" />
      </Grid>

      <TextBox Text="{Binding Filter}" Watermark="제목 · 분야 · 총평으로 검색" />

      <Border Classes="chip" IsVisible="{Binding HasNotice}" Padding="12,8">
        <TextBlock FontSize="12" Foreground="{DynamicResource AppMuted}" Text="{Binding Notice}" />
      </Border>
    </StackPanel>

    <Grid Grid.Row="1" Margin="28,0">
      <TextBlock Classes="muted" IsVisible="{Binding IsEmpty}" Text="{Binding EmptyText}"
                 HorizontalAlignment="Center" VerticalAlignment="Center" />

      <ListBox ItemsSource="{Binding Reports}" SelectedItem="{Binding Selected}"
               Background="Transparent" BorderThickness="0">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="m:PracticeReport">
            <Border Classes="card" Padding="16,14" Margin="0,0,0,10">
              <StackPanel Spacing="5">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Classes="h3" FontSize="15" Text="{Binding Title}" />
                  <Border Grid.Column="1" Classes="chip">
                    <TextBlock FontSize="11" FontWeight="SemiBold" Text="{Binding GoodCriteriaLabel}" />
                  </Border>
                </Grid>
                <TextBlock Classes="muted" Text="{Binding DomainTypeLabel}" />
                <TextBlock Classes="muted" Text="{Binding Evaluation.OverallComment}" MaxLines="2"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Classes="muted" FontSize="11" Text="{Binding DateLabel}" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>

    <Border Grid.Row="2" Background="{DynamicResource AppSurface}"
            BorderBrush="{DynamicResource AppBorder}" BorderThickness="0,1,0,0"
            Padding="28,14">
      <StackPanel Spacing="10">
        <Border IsVisible="{Binding ConfirmingDelete}" CornerRadius="8" Padding="12,10"
                Background="{DynamicResource AppSurfaceAlt}">
          <Grid ColumnDefinitions="*,Auto,Auto" Classes="gap8">
            <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="12"
                       Text="이 기록을 영구 삭제합니다. 되돌릴 수 없습니다." />
            <Button Grid.Column="1" Content="취소" Command="{Binding CancelDeleteCommand}" />
            <Button Grid.Column="2" Classes="danger" Content="삭제"
                    Command="{Binding ConfirmDeleteCommand}" />
          </Grid>
        </Border>

        <Grid ColumnDefinitions="Auto,*,Auto">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
            <Button Content="홈" Command="{Binding BackCommand}" />
            <Button Content="새 연습" Command="{Binding NewPracticeCommand}" />
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
            <Button Classes="danger" Content="삭제" Command="{Binding DeleteCommand}" />
            <Button Classes="primary" Content="열기" MinWidth="130"
                    Command="{Binding OpenCommand}" />
          </StackPanel>
        </Grid>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>

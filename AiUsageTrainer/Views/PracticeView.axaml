<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:AiUsageTrainer.ViewModels"
             xmlns:m="clr-namespace:AiUsageTrainer.Models"
             xmlns:svc="clr-namespace:AiUsageTrainer.Services"
             xmlns:views="clr-namespace:AiUsageTrainer.Views"
             x:Class="AiUsageTrainer.Views.PracticeView"
             x:DataType="vm:PracticeViewModel">

  <Grid RowDefinitions="Auto,Auto,*,Auto">

    <!-- 상단 바 -->
    <Border Grid.Row="0" Background="{DynamicResource AppSurface}"
            BorderBrush="{DynamicResource AppBorder}" BorderThickness="0,0,0,1"
            Padding="24,12">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Spacing="3">
          <TextBlock Classes="h3" Text="{Binding HeaderLabel}" />
          <TextBlock Classes="muted" Text="{Binding Problem.Title}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Border Classes="chip">
            <TextBlock FontSize="12" Text="{Binding ElapsedLabel}" />
          </Border>
          <Button Content="{Binding ProblemToggleText}" Command="{Binding ToggleProblemCommand}" />
          <Button Content="작업 폴더" ToolTip.Tip="협업 AI가 실제로 파일을 만드는 폴더를 엽니다"
                  Command="{Binding OpenWorkspaceCommand}" />
          <Button Classes="link" Content="나가기" Command="{Binding LeaveCommand}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- 문제 -->
    <Border Grid.Row="1" IsVisible="{Binding ShowProblem}"
            Background="{DynamicResource AppSurfaceAlt}"
            BorderBrush="{DynamicResource AppBorder}" BorderThickness="0,0,0,1"
            Padding="24,16" MaxHeight="280">
      <ScrollViewer>
        <StackPanel Spacing="8" MaxWidth="880">
          <TextBlock Classes="h2" Text="{Binding Problem.Title}" />
          <TextBlock Classes="muted" FontStyle="Italic" Text="{Binding Problem.Scenario}" />
          <views:MarkdownView Text="{Binding Problem.Statement}" />
        </StackPanel>
      </ScrollViewer>
    </Border>

    <!-- 대화 + 작업 폴더 -->
    <Grid Grid.Row="2" ColumnDefinitions="*,240">

      <Grid Grid.Column="0" RowDefinitions="*">
        <Border IsVisible="{Binding IsLoadingProblem}" Background="{DynamicResource AppBg}">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
            <ProgressBar IsIndeterminate="True" Width="160" Height="4" Foreground="{DynamicResource AppAccent}" />
            <TextBlock Classes="muted" HorizontalAlignment="Center" Text="{Binding BusyText}" />
          </StackPanel>
        </Border>

        <ScrollViewer Name="ChatScroll" IsVisible="{Binding !IsLoadingProblem}">
          <ItemsControl ItemsSource="{Binding Messages}" MaxWidth="880" Margin="24,20"
                        HorizontalAlignment="Stretch">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="m:ChatMessage">
                <Grid Margin="0,0,0,16">

                  <Border Classes="chip" HorizontalAlignment="Center" IsVisible="{Binding IsSystem}">
                    <TextBlock FontSize="11" Foreground="{DynamicResource AppMuted}" Text="{Binding Text}" />
                  </Border>

                  <StackPanel HorizontalAlignment="Left" MaxWidth="720" Spacing="5"
                              IsVisible="{Binding IsCollaborator}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Classes="muted" FontWeight="SemiBold" Text="{Binding RoleLabel}"
                                 Foreground="{DynamicResource AppAccent}" />
                      <TextBlock Classes="muted" Text="{Binding TimeLabel}" />
                    </StackPanel>
                    <Border Background="{DynamicResource AppSurface}"
                            BorderBrush="{DynamicResource AppBorder}" BorderThickness="1"
                            CornerRadius="12,12,12,4" Padding="16,13">
                      <SelectableTextBlock Text="{Binding Text}" LineHeight="23" />
                    </Border>
                  </StackPanel>

                  <StackPanel HorizontalAlignment="Right" MaxWidth="660" Spacing="5"
                              IsVisible="{Binding IsUser}">
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                      <TextBlock Classes="muted" Text="{Binding TimeLabel}" />
                      <TextBlock Classes="muted" FontWeight="SemiBold" Text="{Binding RoleLabel}" />
                    </StackPanel>
                    <Border Background="{DynamicResource AppUserBubble}"
                            CornerRadius="12,12,4,12" Padding="16,13">
                      <SelectableTextBlock Text="{Binding Text}" LineHeight="23" />
                    </Border>
                  </StackPanel>

                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>

      <!-- 작업 폴더 파일 목록 -->
      <Border Grid.Column="1" Background="{DynamicResource AppSurface}"
              BorderBrush="{DynamicResource AppBorder}" BorderThickness="1,0,0,0">
        <Grid RowDefinitions="Auto,*">
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="12,10">
            <TextBlock Grid.Column="0" Classes="h3" Text="작업 폴더" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="link" Content="새로고침" Command="{Binding RefreshFilesCommand}" />
          </Grid>
          <ScrollViewer Grid.Row="1">
            <StackPanel Margin="12,0,12,12" Spacing="6">
              <TextBlock Classes="muted" IsVisible="{Binding !HasFiles}"
                         Text="아직 만들어진 파일이 없습니다." TextWrapping="Wrap" />
              <ItemsControl ItemsSource="{Binding Files}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="svc:WorkspaceFileInfo">
                    <StackPanel Margin="0,0,0,6">
                      <TextBlock FontSize="12" Text="{Binding RelativePath}"
                                 TextWrapping="Wrap" />
                      <TextBlock Classes="muted" FontSize="10"
                                 Text="{Binding SizeBytes, StringFormat='{}{0:N0} bytes'}" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>

    <!-- 입력 -->
    <Border Grid.Row="3" Background="{DynamicResource AppSurface}"
            BorderBrush="{DynamicResource AppBorder}" BorderThickness="0,1,0,0"
            Padding="24,14">
      <StackPanel Spacing="10" MaxWidth="880" HorizontalAlignment="Stretch">

        <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsBusy}">
          <ProgressBar IsIndeterminate="True" Width="130" Height="4" VerticalAlignment="Center"
                       Foreground="{DynamicResource AppAccent}" />
          <TextBlock Classes="muted" VerticalAlignment="Center" Text="{Binding BusyText}" />
        </StackPanel>

        <Border IsVisible="{Binding HasError}" CornerRadius="8" Padding="12,10"
                Background="{DynamicResource AppAccentSoft}">
          <Grid ColumnDefinitions="*,Auto" Classes="gap12">
            <SelectableTextBlock Grid.Column="0" Classes="danger" FontSize="12" Text="{Binding Error}" />
            <Button Grid.Column="1" Content="다시 시도" VerticalAlignment="Top"
                    Command="{Binding RetryCommand}" />
          </Grid>
        </Border>

        <Border IsVisible="{Binding ConfirmingEnd}" CornerRadius="8" Padding="12,10"
                Background="{DynamicResource AppSurfaceAlt}">
          <Grid ColumnDefinitions="*,Auto,Auto" Classes="gap8">
            <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="12"
                       Text="지금까지의 대화와 작업 폴더 상태로 제출하고 평가받을까요?" />
            <Button Grid.Column="1" Content="계속 풀기" Command="{Binding CancelEndCommand}" />
            <Button Grid.Column="2" Classes="primary" Content="제출하고 평가받기"
                    Command="{Binding ConfirmEndCommand}" />
          </Grid>
        </Border>

        <Border IsVisible="{Binding ConfirmingLeave}" CornerRadius="8" Padding="12,10"
                Background="{DynamicResource AppSurfaceAlt}">
          <Grid ColumnDefinitions="*,Auto,Auto" Classes="gap8">
            <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="12"
                       Text="평가지를 만들지 않고 나갑니다. 작업 폴더도 함께 삭제됩니다." />
            <Button Grid.Column="1" Content="취소" Command="{Binding CancelLeaveCommand}" />
            <Button Grid.Column="2" Classes="danger" Content="저장하지 않고 나가기"
                    Command="{Binding ConfirmLeaveCommand}" />
          </Grid>
        </Border>

        <TextBox Name="AnswerBox"
                 Text="{Binding Draft}"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 MinHeight="92" MaxHeight="220"
                 IsEnabled="{Binding CanInteract}"
                 Watermark="협업 AI에게 보낼 메시지를 입력하세요.  Ctrl+Enter 로 전송" />

        <Grid ColumnDefinitions="Auto,*,Auto">
          <Button Grid.Column="0" Content="제출하고 평가받기" Command="{Binding EndCommand}" />
          <Button Grid.Column="2" Classes="primary" Content="전송  (Ctrl+Enter)" MinWidth="150"
                  Command="{Binding SendCommand}" />
        </Grid>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>

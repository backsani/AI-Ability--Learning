<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:AiUsageTrainer.ViewModels"
             xmlns:m="clr-namespace:AiUsageTrainer.Models"
             x:Class="AiUsageTrainer.Views.ProgressView"
             x:DataType="vm:ProgressViewModel">

  <Grid RowDefinitions="*,Auto">

    <ScrollViewer Grid.Row="0">
      <StackPanel MaxWidth="880" Margin="28,32" Spacing="18" HorizontalAlignment="Center">

        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0" Spacing="6">
            <TextBlock Classes="h1" Text="학습 현황" />
            <TextBlock Classes="muted" Text="{Binding SummaryLine}" />
          </StackPanel>
          <Button Grid.Column="1" VerticalAlignment="Center"
                  Content="{Binding ScopeButtonText}" Command="{Binding ToggleScopeCommand}" />
        </Grid>

        <TextBlock Classes="muted" IsVisible="{Binding IsEmpty}"
                   Text="표시할 분야가 없습니다. [전체 분야 보기]를 눌러보세요."
                   HorizontalAlignment="Center" Margin="0,40" />

        <ItemsControl ItemsSource="{Binding Domains}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:DomainProgress">
              <Border Classes="card" Margin="0,0,0,14">
                <StackPanel Spacing="14">

                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Classes="h2" FontSize="16" Text="{Binding Domain}" />
                    <Border Grid.Column="1" Classes="chip" VerticalAlignment="Center">
                      <TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding HeadLine}" />
                    </Border>
                  </Grid>

                  <ItemsControl ItemsSource="{Binding Types}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="m:DomainTypeStatus">
                        <Grid ColumnDefinitions="*,Auto" Classes="gap12" Margin="0,0,0,7">
                          <TextBlock Grid.Column="0" Text="{Binding TypeName}" />
                          <Border Grid.Column="1" Classes="chip" VerticalAlignment="Center" MinWidth="160">
                            <TextBlock FontSize="11" HorizontalAlignment="Center" Text="{Binding HistoryLabel}" />
                          </Border>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="1" Background="{DynamicResource AppSurface}"
            BorderBrush="{DynamicResource AppBorder}" BorderThickness="0,1,0,0"
            Padding="28,14">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Button Grid.Column="0" Content="홈" Command="{Binding HomeCommand}" />
        <Button Grid.Column="2" Classes="primary" Content="새 연습 시작" MinWidth="140"
                Command="{Binding StartCommand}" />
      </Grid>
    </Border>
  </Grid>
</UserControl>

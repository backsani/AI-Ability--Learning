<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:AiUsageTrainer.ViewModels"
             x:Class="AiUsageTrainer.Views.HomeView"
             x:DataType="vm:HomeViewModel">

  <ScrollViewer>
    <StackPanel MaxWidth="720" Margin="28,40" Spacing="22" HorizontalAlignment="Center">

      <StackPanel Spacing="8">
        <TextBlock Classes="h1" Text="AI와 함께, 실무형 문제를 풀어보세요" />
        <TextBlock Classes="muted" FontSize="13"
                   Text="AI 활용 능력 평가가 요구하는 방식을 기준으로 문제를 내고, 협업 AI와 함께 풀이한 뒤 학습을 위한 평가지를 남깁니다. 채점이 아니라 연습이 목적입니다." />
      </StackPanel>

      <Border Classes="card">
        <StackPanel Spacing="14">
          <StackPanel Spacing="4">
            <TextBlock Classes="h2" Text="연습 시작" />
            <TextBlock Classes="muted" Text="분야와 문제 유형을 고르면 문제를 하나 출제합니다." />
          </StackPanel>
          <Button Classes="primary" Content="새 연습 시작" HorizontalAlignment="Left"
                  IsEnabled="{Binding CliReady}"
                  Command="{Binding StartCommand}" />
          <Border Classes="chip" HorizontalAlignment="Left">
            <TextBlock FontSize="11" Foreground="{DynamicResource AppMuted}"
                       Text="{Binding CliStatus}" />
          </Border>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0" Spacing="6">
            <TextBlock Classes="h2" Text="지난 연습" />
            <TextBlock Classes="muted" Text="{Binding LastReportLine}" />
          </StackPanel>
          <Button Grid.Column="1" VerticalAlignment="Center"
                  Content="열어보기" Command="{Binding HistoryCommand}" />
        </Grid>
      </Border>

      <Border Classes="card">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0" Spacing="6">
            <TextBlock Classes="h2" Text="학습 현황" />
            <TextBlock Classes="muted" Text="분야·유형별로 얼마나 풀어봤는지 확인합니다." />
          </StackPanel>
          <Button Grid.Column="1" VerticalAlignment="Center"
                  Content="열어보기" Command="{Binding ProgressCommand}" />
        </Grid>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Classes="h2" Text="어떻게 진행되나요?" />
          <StackPanel Spacing="7">
            <TextBlock Text="1. 분야와 문제 유형(버그 수정 / 스펙 구현 / 데이터·전략 설계 / 낯선 API 활용)을 고르면 AI가 실무형 문제를 하나 출제합니다." />
            <TextBlock Text="2. 협업 AI가 세션 전용 작업 폴더에서 실제로 파일을 읽고 쓰고 실행하며 함께 풉니다. 어떻게 지시하느냐가 이 연습의 핵심입니다." />
            <TextBlock Text="3. 다 풀었다고 생각하면 [제출하고 평가받기]를 누릅니다." />
            <TextBlock Text="4. 문제 정의 → 계획 → 학습 → 작은 단위 요청 → 검증 → 마무리, 6단계 프롬프트 패턴과 5개 항목 기준으로 학습용 평가지를 받습니다." />
            <TextBlock Text="5. 채점이 아니라 다음에 무엇을 다르게 해보면 좋을지를 위한 평가지입니다." />
          </StackPanel>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>

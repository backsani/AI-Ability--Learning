<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:AiUsageTrainer.ViewModels"
             xmlns:views="clr-namespace:AiUsageTrainer.Views"
             x:Class="AiUsageTrainer.App"
             RequestedThemeVariant="Dark">

  <Application.DataTemplates>
    <DataTemplate DataType="vm:HomeViewModel"><views:HomeView /></DataTemplate>
    <DataTemplate DataType="vm:SetupViewModel"><views:SetupView /></DataTemplate>
    <DataTemplate DataType="vm:PracticeViewModel"><views:PracticeView /></DataTemplate>
    <DataTemplate DataType="vm:ResultViewModel"><views:ResultView /></DataTemplate>
    <DataTemplate DataType="vm:HistoryViewModel"><views:HistoryView /></DataTemplate>
    <DataTemplate DataType="vm:ProgressViewModel"><views:ProgressView /></DataTemplate>
    <DataTemplate DataType="vm:SettingsViewModel"><views:SettingsView /></DataTemplate>
  </Application.DataTemplates>

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>

        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="AppBg"        Color="#F3F2EE" />
          <SolidColorBrush x:Key="AppSurface"   Color="#FFFFFF" />
          <SolidColorBrush x:Key="AppSurfaceAlt" Color="#EAE8E2" />
          <SolidColorBrush x:Key="AppBorder"    Color="#DCD9D1" />
          <SolidColorBrush x:Key="AppText"      Color="#1D1C1A" />
          <SolidColorBrush x:Key="AppMuted"     Color="#6E6B64" />
          <SolidColorBrush x:Key="AppAccent"    Color="#2F6FB3" />
          <SolidColorBrush x:Key="AppAccentText" Color="#FFFFFF" />
          <SolidColorBrush x:Key="AppAccentSoft" Color="#DCE7F4" />
          <SolidColorBrush x:Key="AppUserBubble" Color="#E4E1D9" />
          <SolidColorBrush x:Key="AppDanger"    Color="#B33A2F" />
          <SolidColorBrush x:Key="AppGood"      Color="#2F7A4A" />
          <SolidColorBrush x:Key="AppWarn"      Color="#A2700F" />

        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="AppBg"        Color="#1A1917" />
          <SolidColorBrush x:Key="AppSurface"   Color="#242320" />
          <SolidColorBrush x:Key="AppSurfaceAlt" Color="#2E2C29" />
          <SolidColorBrush x:Key="AppBorder"    Color="#3B3934" />
          <SolidColorBrush x:Key="AppText"      Color="#EFEDE7" />
          <SolidColorBrush x:Key="AppMuted"     Color="#A5A199" />
          <SolidColorBrush x:Key="AppAccent"    Color="#5B9BD9" />
          <SolidColorBrush x:Key="AppAccentText" Color="#1A1917" />
          <SolidColorBrush x:Key="AppAccentSoft" Color="#233245" />
          <SolidColorBrush x:Key="AppUserBubble" Color="#33312D" />
          <SolidColorBrush x:Key="AppDanger"    Color="#E5715F" />
          <SolidColorBrush x:Key="AppGood"      Color="#6FBF8B" />
          <SolidColorBrush x:Key="AppWarn"      Color="#DDB55A" />

        </ResourceDictionary>

      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light" Accent="#2F6FB3" />
        <ColorPaletteResources x:Key="Dark" Accent="#5B9BD9" />
      </FluentTheme.Palettes>
    </FluentTheme>

    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource AppText}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="SelectableTextBlock">
      <Setter Property="Foreground" Value="{DynamicResource AppText}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="TextBlock.h1">
      <Setter Property="FontSize" Value="26" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="TextBlock.h2">
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="TextBlock.h3">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource AppMuted}" />
      <Setter Property="FontSize" Value="12" />
    </Style>

    <Style Selector="TextBlock.danger">
      <Setter Property="Foreground" Value="{DynamicResource AppDanger}" />
    </Style>

    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource AppSurface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="18" />
    </Style>

    <Style Selector="Border.chip">
      <Setter Property="Background" Value="{DynamicResource AppSurfaceAlt}" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="8,3" />
    </Style>

    <Style Selector="Button">
      <Setter Property="Background" Value="{DynamicResource AppSurfaceAlt}" />
      <Setter Property="Foreground" Value="{DynamicResource AppText}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppBorder}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppMuted}" />
      <Setter Property="TextBlock.Foreground" Value="{DynamicResource AppText}" />
    </Style>

    <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Opacity" Value="0.45" />
    </Style>

    <Style Selector="Button.primary /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppAccent}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppAccent}" />
      <Setter Property="TextBlock.Foreground" Value="{DynamicResource AppAccentText}" />
    </Style>

    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppAccent}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppText}" />
      <Setter Property="TextBlock.Foreground" Value="{DynamicResource AppAccentText}" />
    </Style>

    <Style Selector="Button.primary">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="Button.danger">
      <Setter Property="Foreground" Value="{DynamicResource AppDanger}" />
    </Style>

    <Style Selector="Button.danger /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="TextBlock.Foreground" Value="{DynamicResource AppDanger}" />
    </Style>

    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="0" />
    </Style>

    <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="ListBoxItem:pointerover Border.card">
      <Setter Property="BorderBrush" Value="{DynamicResource AppMuted}" />
    </Style>

    <Style Selector="ListBoxItem:selected Border.card">
      <Setter Property="BorderBrush" Value="{DynamicResource AppAccent}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>

    <Style Selector="Button.link">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource AppMuted}" />
      <Setter Property="Padding" Value="8,6" />
    </Style>

    <Style Selector="Button.link /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="TextBox">
      <Setter Property="Background" Value="{DynamicResource AppSurface}" />
      <Setter Property="Foreground" Value="{DynamicResource AppText}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="SelectionBrush" Value="{DynamicResource AppAccentSoft}" />
    </Style>

    <Style Selector="ComboBox">
      <Setter Property="Background" Value="{DynamicResource AppSurface}" />
      <Setter Property="Foreground" Value="{DynamicResource AppText}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="MinHeight" Value="34" />
    </Style>

    <Style Selector="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource AppText}" />
    </Style>

    <Style Selector="ScrollViewer">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- Markdown rendering (problem statements) -->
    <Style Selector="SelectableTextBlock.md-p">
      <Setter Property="LineHeight" Value="24" />
      <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="SelectableTextBlock.md-h1">
      <Setter Property="FontSize" Value="22" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="SelectableTextBlock.md-h2">
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource AppAccent}" />
    </Style>
    <Style Selector="SelectableTextBlock.md-h3">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="SelectableTextBlock.md-quote">
      <Setter Property="Foreground" Value="{DynamicResource AppMuted}" />
      <Setter Property="LineHeight" Value="22" />
    </Style>
    <Style Selector="TextBlock.md-bullet">
      <Setter Property="Foreground" Value="{DynamicResource AppAccent}" />
      <Setter Property="LineHeight" Value="24" />
    </Style>
    <Style Selector="Border.md-code">
      <Setter Property="Background" Value="{DynamicResource AppSurfaceAlt}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Border.md-quote-border">
      <Setter Property="BorderBrush" Value="{DynamicResource AppAccent}" />
      <Setter Property="BorderThickness" Value="3,0,0,0" />
      <Setter Property="Background" Value="{DynamicResource AppSurfaceAlt}" />
    </Style>
    <Style Selector="Border.md-rule">
      <Setter Property="Background" Value="{DynamicResource AppBorder}" />
    </Style>

    <!-- Grid gaps: Avalonia 11.2 has no Row/ColumnSpacing, so space the children instead. -->
    <Style Selector="Grid.gap8 &gt; :is(Control)">
      <Setter Property="Margin" Value="0,0,8,0" />
    </Style>
    <Style Selector="Grid.gap8 &gt; :is(Control):nth-last-child(1)">
      <Setter Property="Margin" Value="0" />
    </Style>

    <Style Selector="Grid.gap12 &gt; :is(Control)">
      <Setter Property="Margin" Value="0,0,12,0" />
    </Style>
    <Style Selector="Grid.gap12 &gt; :is(Control):nth-last-child(1)">
      <Setter Property="Margin" Value="0" />
    </Style>

    <Style Selector="Grid.gap18 &gt; :is(Control)">
      <Setter Property="Margin" Value="0,0,18,0" />
    </Style>
    <Style Selector="Grid.gap18 &gt; :is(Control):nth-last-child(1)">
      <Setter Property="Margin" Value="0" />
    </Style>

    <Style Selector="Grid.gap24 &gt; :is(Control)">
      <Setter Property="Margin" Value="0,0,24,0" />
    </Style>
    <Style Selector="Grid.gap24 &gt; :is(Control):nth-last-child(1)">
      <Setter Property="Margin" Value="0" />
    </Style>

    <Style Selector="Grid.gapv14 &gt; :is(Control)">
      <Setter Property="Margin" Value="0,0,0,14" />
    </Style>
  </Application.Styles>
</Application>
